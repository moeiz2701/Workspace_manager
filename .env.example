# Supabase project — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Safe to expose: RLS is the guard (§8.2).
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Used to build the OAuth redirectTo. On Vercel previews, set from VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# There is intentionally NO SUPABASE_SERVICE_ROLE_KEY here. All privileged
# logic is a SECURITY DEFINER Postgres function with an internal permission
# check (§2, rule 4). Do not add one.

# Local development only (§8.4). Enables a password sign-in on /login so the
# app and the Playwright suite can be used without Google OAuth. It has no
# effect unless NEXT_PUBLIC_SUPABASE_URL points at localhost, so it cannot be
# switched on in production.
# NEXT_PUBLIC_DEV_LOGIN=true
